# Copie para .env e ajuste para seu ambiente (VPS / aaPanel / PostgreSQL local)

# PostgreSQL — use a mesma URL do aaPanel ou do Postgres no servidor
EXTERNAL_DATABASE_URL=postgresql://postgres:senha@localhost:5432/smartag_db

# JWT / sessão (obrigatório em produção)
SESSION_SECRET=chave-secreta-jwt

NODE_ENV=production
PORT=3002

# Docker na VPS: o compose lê este .env automaticamente.
# Se o Postgres está no host (URL com localhost), o entrypoint do container
# reescreve localhost → host.docker.internal para conectar ao banco do host.
#
# Desenvolvimento com Postgres no Docker:
# docker compose -f docker-compose.yml -f docker-compose.dev.yml --profile local-db up --build -d
